---
/** "Page 2 of 26" with links to the previous and next page. Hidden when there is one page. */
interface Props {
  page: number;
  numPages: number;
  prev: string | null;
  next: string | null;
}

const { page, numPages, prev, next } = Astro.props;
const button =
  'relative inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-zinc-900 ring-1 ring-inset ring-zinc-300 hover:bg-zinc-50';
---

{
  numPages > 1 && (
    <nav
      class="flex items-center justify-between border-t border-zinc-200 px-4 py-3 sm:px-6 mt-8"
      aria-label="Pagination"
    >
      <div class="hidden sm:block">
        <p class="text-sm text-zinc-700">
          Page <span class="font-medium">{page}</span> of <span class="font-medium">{numPages}</span>
        </p>
      </div>
      <div class="flex flex-1 justify-between sm:justify-end gap-3">
        {prev && <a class={button} rel="prev" href={prev}>← Previous</a>}{next && <a class={button} rel="next" href={next}>Next →</a>}
      </div>
    </nav>
  )
}
