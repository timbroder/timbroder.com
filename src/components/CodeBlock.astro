---
/**
 * A highlighted block of code, looking the same as the code blocks in posts.
 * Posts get theirs from the markdown processor; this is for everything else
 * (Contentful posts, the component library).
 */
import { Code } from 'astro:components';
import type { BuiltinLanguage, SpecialLanguage } from 'shiki';
import { codeTheme } from '../lib/code-theme.ts';

interface Props {
  code: string;
  lang?: BuiltinLanguage | SpecialLanguage;
}

const { code, lang = 'text' } = Astro.props;
---

<Code code={code} lang={lang} theme={codeTheme} />
