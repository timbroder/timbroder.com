---
interface Props {
  slug: string
  title: string
  date: string
  category?: string
  description?: string
  link?: string
  showDesc?: boolean
}

const { slug, title, date, category, description, link, showDesc = true } = Astro.props
---

<article class="md:grid md:grid-cols-4 md:items-baseline">
  <div class="group relative flex flex-col items-start md:col-span-3">
    <h2 class="text-base font-semibold tracking-tight text-zinc-800">
      <div class="absolute -inset-y-6 -inset-x-4 z-0 scale-95 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 sm:-inset-x-6 sm:rounded-2xl" />
      <a href={slug}>
        <span class="absolute -inset-y-6 -inset-x-4 z-20 sm:-inset-x-6 sm:rounded-2xl" />
        <span class="relative z-10">{title}</span>
      </a>
    </h2>
    <p
      class="relative z-10 order-first mb-3 flex items-center text-sm text-zinc-400 pl-3.5 md:hidden"
    >
      <span class="absolute inset-y-0 left-0 flex items-center" aria-hidden="true">
        <span class="h-4 w-0.5 rounded-full bg-zinc-200" />
      </span>
      <time datetime={date}>{date}</time>
      {category && <span>&nbsp;in {category}</span>}
    </p>
    {showDesc && description && (
      <p class="relative z-10 mt-2 text-sm text-zinc-600">
        {description}
      </p>
    )}
    <div
      aria-hidden="true"
      class="relative z-10 mt-4 flex items-center text-sm font-medium text-teal-500"
    >
      Read {link ? 'commentary' : 'article'}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ml-1 h-4 w-4 stroke-current">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </div>
  </div>
  <p class="relative z-10 order-first mb-3 flex items-center text-sm text-zinc-400 mt-1 hidden md:block">
    <time datetime={date}>{date}</time>
    {category && <span>&nbsp;in {category}</span>}
  </p>
</article>
