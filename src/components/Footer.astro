---
const navItems = [
  { title: 'Posts', slug: '/' },
  { title: 'Podcasts', slug: '/podcasts/' },
  { title: 'Projects', slug: '/projects/' },
  { title: 'Talks', slug: '/talks/' },
  { title: 'About', slug: '/about/' },
]

const currentYear = new Date().getFullYear()
---

<footer class="mt-32">
  <div class="sm:px-8">
    <div class="mx-auto max-w-7xl lg:px-8">
      <div class="border-t border-zinc-100 pt-10 pb-16">
        <div class="relative px-4 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
              <div class="flex gap-6 text-sm font-medium text-zinc-800">
                {navItems.map((item) => (
                  <a href={item.slug} class="transition hover:text-teal-500">
                    {item.title}
                  </a>
                ))}
              </div>
              <p class="text-sm text-zinc-400">
                &copy; 2007 - {currentYear} Tim Broder. All rights reserved.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
