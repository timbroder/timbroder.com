---
/** The site footer: the navigation again, and the copyright line. */
import { SITE } from '../lib/site.ts';

interface Props {
  /** The year shown in the copyright line. Defaults to the year of the build. */
  year?: number;
}

const { year = new Date().getUTCFullYear() } = Astro.props;
---

<footer class="mt-32">
  <div class="sm:px-8">
    <div class="mx-auto max-w-7xl lg:px-8">
      <div class="border-t border-zinc-100 pt-10 pb-16">
        <div class="relative px-4 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
              <div class="flex gap-6 text-sm font-medium text-zinc-800">
                {SITE.nav.map((item) => <a href={item.href} class="transition hover:text-teal-500">{item.title}</a>)}
              </div>
              <p class="text-sm text-zinc-400">
                &copy; {SITE.since} - {year} {SITE.author}. All rights reserved.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
