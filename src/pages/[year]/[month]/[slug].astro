---
import LinkPostBanner from '../../../components/LinkPostBanner.astro';
import PostHeader from '../../../components/PostHeader.astro';
import PostMeta from '../../../components/PostMeta.astro';
import PostNav from '../../../components/PostNav.astro';
import Prose from '../../../components/Prose.astro';
import Base from '../../../layouts/Base.astro';
import { neighbours, type Neighbours } from '../../../lib/lists.ts';
import type { Post } from '../../../lib/post-model.ts';
import { getPosts } from '../../../lib/posts.ts';
import { hasWords } from '../../../lib/search-index.ts';
import { articleData, scriptJson } from '../../../lib/seo.ts';
import { isoDate } from '../../../lib/site.ts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const [year, month, slug] = post.url.split('/').filter(Boolean);
    return { params: { year, month, slug }, props: { post, ...neighbours(posts, post) } };
  });
}

interface Props extends Neighbours {
  post: Post;
}

const { post, newer, older } = Astro.props;
---

<Base title={post.title} description={post.description} image={post.image}>
  <script is:inline slot="head" type="application/ld+json" set:html={scriptJson(articleData(post))} />
  {
    /*
     * The search index takes the text of the post from the body below, and
     * from here what a search result shows beside it. The title, which it
     * finds in the headline, and the tags can be searched too.
     */
  }
  <article
    itemscope
    itemtype="http://schema.org/Article"
    data-pagefind-meta="date[data-date], category[data-category], tags[data-tags]"
    data-date={isoDate(post.date)}
    data-category={post.category}
    data-tags={post.tags.join(', ') || undefined}
  >
    <PostHeader title={post.title} date={post.date} titleIsText={!hasWords(post.html)} />
    <Prose class="mt-8">
      {post.link && <LinkPostBanner href={post.link} />}
      <section itemprop="articleBody" data-pagefind-body set:html={post.html} />
    </Prose>
    <PostMeta tags={post.tags} category={post.category} />
  </article>
  <PostNav newer={newer} older={older} />
</Base>
