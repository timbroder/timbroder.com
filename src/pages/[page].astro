---
/** Markdown pages from content/pages, each at the `path:` in its frontmatter. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Headline from '../components/Headline.astro';
import Prose from '../components/Prose.astro';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('pages')).map((entry) => ({
    params: { page: entry.data.path.replace(/^\/|\/$/g, '') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <header class="flex flex-col">
    <Headline padded={false}>{entry.data.title}</Headline>
  </header>
  <Prose class="mt-8">
    <section itemprop="articleBody"><Content /></section>
  </Prose>
</Base>
