---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const pages = await getCollection('pages');

// Netlify sets COMMIT_REF. The smoke tests read it to know which build they
// are looking at.
const commit = process.env.COMMIT_REF ?? 'local';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="build-commit" content={commit} />
    <title>Tim Broder .com</title>
  </head>
  <body>
    <main>
      <h1>Tim Broder .com</h1>
      <p>Astro migration in progress.</p>
      <p data-count="posts">{posts.length}</p>
      <p data-count="pages">{pages.length}</p>
    </main>
  </body>
</html>
