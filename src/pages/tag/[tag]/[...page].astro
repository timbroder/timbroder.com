---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import SEO from '../../../components/SEO.astro'
import PostCard from '../../../components/PostCard.astro'
import Pagination from '../../../components/Pagination.astro'
import Headline from '../../../components/Headline.astro'
import { getAllPosts, getAllTags, filterByTag } from '../../../lib/posts'

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getAllPosts()
  const tags = getAllTags(allPosts)

  const paths = []
  for (const [tagSlug, tagInfo] of tags) {
    const tagPosts = filterByTag(allPosts, tagInfo.name)
    const paginated = paginate(tagPosts, {
      params: { tag: tagSlug },
      pageSize: 20,
    })
    paths.push(...paginated)
  }
  return paths
}) satisfies GetStaticPaths

const { page } = Astro.props
const { tag } = Astro.params
const currentPage = page.currentPage
const totalPages = page.lastPage
const basePath = `/tag/${tag}/`

// Find the display name for this tag
const allPosts = page.data
const tagName = allPosts.length > 0
  ? allPosts[0].tags.find((t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') === tag) || tag
  : tag

const isFirst = currentPage === 1
const isLast = currentPage === totalPages
const prevPage = currentPage - 1 === 1 ? basePath : `${basePath}page/${currentPage - 1}/`
const nextPage = `${basePath}page/${currentPage + 1}/`
const title = currentPage === 1 ? `Tag: ${tagName}` : `Tag: ${tagName} - Page ${currentPage}`
---

<BaseLayout>
  <Fragment slot="head">
    <SEO title={title} pathname={Astro.url.pathname} />
    {!isFirst && <link rel="prev" href={prevPage} />}
    {!isLast && <link rel="next" href={nextPage} />}
  </Fragment>

  <header class="flex flex-col">
    <Headline>Tag: {tagName}</Headline>
  </header>

  <div class="md:border-l md:border-zinc-100 md:pl-6">
    <div class="flex max-w-3xl flex-col space-y-16">
      {page.data.map((post) => (
        <PostCard
          slug={post.slug}
          title={post.title}
          date={post.formattedDate}
          category={post.category}
          description={post.description}
          link={post.link}
        />
      ))}
    </div>
  </div>

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={basePath}
  />
</BaseLayout>
